 FILEFLAGS       0
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "MessyGear Studios"
            VALUE "FileDescription",  "Aaron x64bit Windows"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "Aaron"
            VALUE "OriginalFilename", "Aaron.exe"
            VALUE "ProductName",      "Aaron"
            VALUE "ProductVersion",   "1.0.0"
            VALUE "LegalCopyright",   "CC0 (Free To Copy)"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 1200, 0x0409
    END
END